# Comma-separated GitHub repositories to collect.
REPOS=owner/repo,another-owner/another-repo

# Optional token for higher GitHub REST API rate limits.
GITHUB_TOKEN=

# Optional database path and logging level.
DB_PATH=release_analytics.sqlite3
LOG_LEVEL=INFO

# Optional comma-separated release tags to omit from dashboard metrics, charts, tables, and selectors.
EXCLUDED_RELEASE_TAGS=

# Web-mode collector cadence. Each repo aligns independently to its latest
# tracked non-draft release's published_at time after startup discovery; before
# a repo has known releases, the scheduler uses this fixed discovery interval.
RUN_INTERVAL_SECONDS=21600
COLLECT_ON_START=true
